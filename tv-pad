class Desktop:
    """uinput keyboard + mouse, the on-screen keyboard, commands and notifications."""

    def __init__(self, cfg, evdev, mapper_keys):
        e = evdev.ecodes
        self.cfg, self.e = cfg, e
        mouse_keys = [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE, e.BTN_SIDE, e.BTN_EXTRA]
        self.mouse = evdev.UInput(
            {e.EV_KEY: mouse_keys,
             e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_HWHEEL, e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES]},
            name=f"{APP} mouse")
        keys = sorted(set(mapper_keys) - set(mouse_keys)) or [e.KEY_ENTER]
        self.keyboard = evdev.UInput({e.EV_KEY: keys}, name=f"{APP} keyboard")
        self.mouse_keys = set(mouse_keys)
        self.osk = None
        self._dirty = set()  # devices with events waiting for a SYN
        self.session = Session(cfg)

    def key(self, code, down):
        dev = self.mouse if code in self.mouse_keys else self.keyboard
        dev.write(self.e.EV_KEY, code, 1 if down else 0)
        self._dirty.add(dev)

    def rel(self, code, value):
        self.mouse.write(self.e.EV_REL, code, value)
        self._dirty.add(self.mouse)

    def syn(self):
        for dev in self._dirty:
            dev.syn()
        self._dirty.clear()

    def osk_start(self):
        cmd = self.cfg["osk_command"]
        if self.osk and self.osk.poll() is None:
            return
        if not cmd or not shutil.which(cmd[0]):
            self.osk = None
            return
        self.osk = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def osk_toggle(self):
        if not self.osk or self.osk.poll() is not None:
            self.osk_start()  # a fresh keyboard shows up by itself
            if not self.osk:
                notify("Brak klawiatury ekranowej: zainstaluj wvkbd (albo ustaw osk_command).", self.cfg["notifications"])
            return
        self.osk.send_signal(signal.SIGRTMIN)  # wvkbd: toggle visibility

    def osk_stop(self):
        if self.osk and self.osk.poll() is None:
            self.osk.terminate()
        self.osk = None

    def run(self, command):
        subprocess.Popen(["sh", "-c", command], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)

    def notify(self, text):
        notify(text, self.cfg["notifications"])

    def screen_toggle(self):
        self.session.screen_toggle(self.notify)

    def end_stream(self):
        self.session.end_stream(self.notify)

    def screen_on(self):
        self.session.screen_on()

    def close(self):
        self.osk_stop()
        if self.session.worker is not None:
            self.session.worker.join(timeout=10)  # let a running monitor job finish
        self.session.background = False  # the process is about to exit: do it now
        self.screen_on()
        self.mouse.close()
        self.keyboard.close()


def run_daemon():
    import evdev  # imported here so `tv-pad on/off/status` work without python-evdev

    e = evdev.ecodes
    cfg = load_config()
    def prepare(cfg):
        probe = Mapper(cfg, e, out=None)
        Mapper(watch_only_config(cfg), e, out=None)
        res = {key: [re.compile(p) for p in cfg[key]]
               for key in ("pause_for_windows", "watch_only_apps", "watch_only_windows")}
        return probe, res

    try:
        probe, res = prepare(cfg)
    except (ValueError, re.error) as err:
        notify(f"Błąd w {CONFIG_PATH}: {err}. Używam ustawień domyślnych.")
        cfg = merge_config(None)
        probe, res = prepare(cfg)

    def matches(key, text):
        return bool(text) and any(r.search(text) for r in res[key])

    # Every key any action may press, so the virtual keyboard can send it.
    all_codes = set()
    for action in list(probe.buttons.values()) + list(probe.combos.values()):
        all_codes.update(action.codes)

    desktop = None
    mapper = None
    watch_mapper = None   # Steam streams: only watch_only_combos
    watch = False         # pad stays with the game (Steam), only the combos are watched
    stream_app = ""
    pause_window = watch_window = False
    sunshine_log = SunshineLog(SUNSHINE_LOG)
    pads = {}          # path -> (InputDevice, PadState)
    sel = selectors.DefaultSelector()
    active = False     # stream running
    paused = False     # user pause (Xbox hold) or a game has focus
    user_paused = False
    grabbed = False
    last_scan = last_state = last_focus = 0.0
    focus_pause = False
    stop = False

    def handle_signal(*_):
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    def set_grab(want):
        nonlocal grabbed
        if want == grabbed:
            return
        for dev, _ in pads.values():
            try:
                dev.grab() if want else dev.ungrab()
            except OSError:
                pass
        grabbed = want

    def scan():
        for path in evdev.list_devices():
            if path in pads:
                continue
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue
            if not is_gamepad(dev, e):
                dev.close()
                continue
            info = {code: (ai.min, ai.max) for code, ai in dev.capabilities(absinfo=True).get(e.EV_ABS, [])}
            pads[path] = (dev, PadState(info, e))
            sel.register(dev, selectors.EVENT_READ, path)
            log(f"pad: {dev.name} ({path})")
            if grabbed:
                try:
                    dev.grab()
                except OSError:
                    pass

    def drop(path):
        dev, _ = pads.pop(path)
        try:
            sel.unregister(dev)
        except (KeyError, ValueError):
            pass
        try:
            dev.close()
        except OSError:
            pass
        log(f"pad gone: {path}")

    log(f"started (version {VERSION}); waiting for a stream")
    frame = 1 / 250
    last_tick = time.monotonic()
    while not stop:
        now = time.monotonic()
        if now - last_scan > 2.0:
            scan()
            last_scan = now
        if now - last_state > 0.5:
            last_state = now
            client = sunshine_log.poll()
            want_active = os.path.exists(ACTIVE_FLAG) and client is not False and sunshine_running()
            if want_active != active:
                active = want_active
                user_paused = False
                if active:
                    if desktop is None:
                        try:
                            desktop = Desktop(cfg, evdev, all_codes)
                        except OSError as err:
                            log(f"cannot create virtual mouse/keyboard ({err}); is /dev/uinput accessible?")
                            active = False
                            continue
                        mapper = Mapper(cfg, e, desktop)
                        watch_mapper = Mapper(watch_only_config(cfg), e, desktop)
                    stream_app = read_stream_app()
                    log(f"stream started (app: {stream_app or 'unknown'})")
                    if not matches("watch_only_apps", stream_app):
                        desktop.notify("Stream: pad steruje pulpitem")
                else:
                    for m in (mapper, watch_mapper):
                        if m:
                            m.release_all()
                    if desktop:
                        desktop.osk_stop()
                        desktop.screen_on()  # never leave the PC monitor dark after a stream
                    log("stream paused" if os.path.exists(ACTIVE_FLAG) else "stream ended")
        if active and now - last_focus > 0.5:
            last_focus = now
            cls = focused_window_class()
            ww = matches("watch_only_windows", cls)
            pw = matches("pause_for_windows", cls) and not ww
            if (ww, pw) != (watch_window, pause_window):
                watch_window, pause_window = ww, pw
                if ww or pw:
                    log(f"window {cls!r}: {'Steam, only View+Left' if ww else 'pausing'}")
        want_watch = active and (matches("watch_only_apps", stream_app) or watch_window)
        if want_watch != watch:
            watch = want_watch
            for m in (mapper, watch_mapper):
                if m:
                    m.release_all()
            if watch and desktop:
                desktop.notify("Steam: pad steruje grą. View + ← kończy stream")
        want_paused = (not active) or user_paused or (pause_window and not watch)
        if want_paused != paused:
            paused = want_paused
            if paused and mapper:
                mapper.release_all()
        set_grab(active and not paused and not watch)

        timeout = frame if (active and not paused) else 0.5
        for key, _ in sel.select(timeout=timeout):
            path = key.data
            if path not in pads:
                continue
            dev, state = pads[path]
            try:
                events = list(dev.read())
            except OSError:
                drop(path)
                continue
            if not active or mapper is None:
                continue
            for ev in events:
                controls, axes = pad_event_to_controls(ev.type, ev.code, ev.value, e, cfg["swap_xy"])
                if watch:
                    for name, pressed in controls:
                        watch_mapper.control(name, pressed)
                    for code, value in axes:  # the d-pad may come as a hat axis
                        if code in (e.ABS_HAT0X, e.ABS_HAT0Y):
                            state.axis(code, value, watch_mapper)
                    continue
                if paused:
                    # while paused only watch the pause control
                    for name, pressed in controls:
                        if name == cfg["pause_hold"]:
                            mapper.pause_since = now if pressed else None
                    continue
                for name, pressed in controls:
                    mapper.control(name, pressed)
                for code, value in axes:
                    state.axis(code, value, mapper)
        now = time.monotonic()
        if active and not watch and mapper is not None and mapper.pause_requested(now):
            user_paused = not user_paused
            if user_paused:
                mapper.release_all()
            desktop.notify("Pad: pauza (przytrzymaj Xbox, żeby wrócić)" if user_paused else "Pad: steruje pulpitem")
        if active and not paused and not watch and mapper is not None:
            mapper.tick(min(0.05, now - last_tick))
        last_tick = now

    for m in (mapper, watch_mapper):
        if m:
            m.release_all()
    set_grab(False)
    if desktop:
        desktop.close()
    log("stopped")


# ----------------------------------------------------------------------------- CLI helpers

def cmd_on():
    """Called by Sunshine when a stream starts; it passes the app name in SUNSHINE_APP_NAME."""
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(ACTIVE_FLAG, "w", encoding="utf-8") as f:
        json.dump({"app": os.environ.get("SUNSHINE_APP_NAME", ""), "since": time.time()}, f)


def read_stream_app():
    """Name of the streamed Sunshine app, or "" if unknown."""
    try:
        with open(ACTIVE_FLAG, encoding="utf-8") as f:
            data = json.load(f)
        return str(data.get("app") or "") if isinstance(data, dict) else ""
    except (OSError, ValueError):
        return ""


def watch_only_config(cfg):
    """Config for Steam streams: no desktop controls, only the watch_only_combos."""
    w = json.loads(json.dumps(cfg))
    w["buttons"] = {name: "none" for name in CONTROLS}
    w["combos"] = dict(cfg["watch_only_combos"])
    w["pause_hold"] = ""
    return w


def cmd_off():
    try:
        os.remove(ACTIVE_FLAG)
    except FileNotFoundError:
        pass


def cmd_status():
    flag = os.path.exists(ACTIVE_FLAG)
    sun = sunshine_running()
    print(f"stream flag: {'on' if flag else 'off'}")
    print(f"sunshine:    {'running' if sun else 'not running'}")
    client = SunshineLog(SUNSHINE_LOG).poll()
    client_text = {True: "connected", False: "disconnected (stream paused)", None: "unknown (no entry in sunshine.log)"}[client]
    print(f"client:      {client_text}")
    if flag:
        print(f"app:         {read_stream_app() or 'unknown'}")
    print(f"active:      {'yes' if flag and sun and client is not False else 'no'}")
    print(f"config:      {CONFIG_PATH}{'' if os.path.exists(CONFIG_PATH) else ' (defaults, file not created)'}")


def cmd_config():
    if not os.path.exists(CONFIG_PATH):
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_CONFIG, f, indent=2, ensure_ascii=False)
            f.write("\n")
        print(f"created {CONFIG_PATH}")
    else:
        print(CONFIG_PATH)


PREP_ENTRY = {"do": "/usr/bin/tv-pad on", "undo": "/usr/bin/tv-pad off"}


def add_prep_cmd(conf_text):
    """Return sunshine.conf text with our global_prep_cmd entry (unchanged if already there)."""
    lines = conf_text.splitlines()
    for i, line in enumerate(lines):
        m = re.match(r"\s*global_prep_cmd\s*=\s*(.*)$", line)
        if not m:
            continue
        try:
            entries = json.loads(m.group(1) or "[]")
        except ValueError:
            raise ValueError("global_prep_cmd in sunshine.conf is not valid JSON; add the entry by hand")
        if any(isinstance(x, dict) and "tv-pad" in str(x.get("do", "")) for x in entries):
            return conf_text
        entries.append(PREP_ENTRY)
        lines[i] = "global_prep_cmd = " + json.dumps(entries)
        return "\n".join(lines) + "\n"
    return conf_text.rstrip("\n") + ("\n" if conf_text.strip() else "") + \
        "global_prep_cmd = " + json.dumps([PREP_ENTRY]) + "\n"


def cmd_setup_sunshine():
    try:
        with open(SUNSHINE_CONF, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    new = add_prep_cmd(text)
    if new == text:
        print(f"{SUNSHINE_CONF}: already set up")
        return
    os.makedirs(os.path.dirname(SUNSHINE_CONF), exist_ok=True)
    if text:
        with open(SUNSHINE_CONF + ".bak", "w", encoding="utf-8") as f:
            f.write(text)
    with open(SUNSHINE_CONF, "w", encoding="utf-8") as f:
        f.write(new)
    print(f"{SUNSHINE_CONF}: added global_prep_cmd (backup: sunshine.conf.bak)")
    print("Restart Sunshine:  systemctl --user restart app-dev.lizardbyte.app.Sunshine.service")


def cmd_test():
    import evdev
    e = evdev.ecodes
    cfg = load_config()
    pads = [evdev.InputDevice(p) for p in evdev.list_devices()]
    pads = [d for d in pads if is_gamepad(d, e)]
    if not pads:
        print("No pad found. Connect it and try again.")
        return
    print("Press buttons on the pad (Ctrl+C to stop):")
    for d in pads:
        print(f"  {d.path}: {d.name}")
    sel = selectors.DefaultSelector()
    for d in pads:
        sel.register(d, selectors.EVENT_READ)
    try:
        while True:
            for key, _ in sel.select():
                for ev in key.fileobj.read():
                    controls, _ = pad_event_to_controls(ev.type, ev.code, ev.value, e, cfg["swap_xy"])
                    for name, pressed in controls:
                        if pressed:
                            action = cfg["buttons"].get(name, "none")
                            print(f"  {name:6} -> {action}")
    except KeyboardInterrupt:
        pass


def main(argv=None):
    parser = argparse.ArgumentParser(prog=APP, description="Gamepad control of the desktop while streaming to the TV.")
    parser.add_argument("command", nargs="?", default="run",
                        choices=["run", "on", "off", "toggle", "status", "config", "setup-sunshine", "test", "version"])
    args = parser.parse_args(argv)
    if args.command == "run":
        run_daemon()
    elif args.command == "on":
        cmd_on()
    elif args.command == "off":
        cmd_off()
    elif args.command == "toggle":
        cmd_off() if os.path.exists(ACTIVE_FLAG) else cmd_on()
    elif args.command == "status":
        cmd_status()
    elif args.command == "config":
        cmd_config()
    elif args.command == "setup-sunshine":
        cmd_setup_sunshine()
    elif args.command == "test":
        cmd_test()
    elif args.command == "version":
        print(VERSION)


if __name__ == "__main__":
    main()
