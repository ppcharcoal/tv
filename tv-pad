def merge_config(user):
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if not isinstance(user, dict):
        return cfg
    for key, value in user.items():
        if key not in cfg:
            continue
        if key in ("buttons", "combos") and isinstance(value, dict):
            cfg[key].update({k: v for k, v in value.items() if isinstance(v, str)})
        elif isinstance(cfg[key], bool):
            cfg[key] = bool(value)
        elif isinstance(cfg[key], (int, float)) and isinstance(value, (int, float)) and not isinstance(value, bool):
            cfg[key] = float(value)
        elif isinstance(cfg[key], list) and isinstance(value, list):
            cfg[key] = [str(v) for v in value]
        elif isinstance(cfg[key], str) and isinstance(value, str):
            cfg[key] = value
    return cfg


def load_config():
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            return merge_config(json.load(f))
    except FileNotFoundError:
        return merge_config(None)
    except (OSError, ValueError) as err:
        log(f"cannot read {CONFIG_PATH}: {err} (using defaults)")
        return merge_config(None)


def log(msg):
    print(f"[{APP}] {msg}", file=sys.stderr, flush=True)


# ----------------------------------------------------------------------------- actions

class Action:
    """A parsed action string. kind: key | mouse | osk | cmd | none."""

    __slots__ = ("kind", "codes", "command")

    def __init__(self, kind, codes=(), command=""):
        self.kind, self.codes, self.command = kind, tuple(codes), command

    def __eq__(self, other):
        return isinstance(other, Action) and (self.kind, self.codes, self.command) == (other.kind, other.codes, other.command)

    def __repr__(self):
        return f"Action({self.kind}, {self.codes}, {self.command!r})"


MOUSE_BUTTONS = {"LEFT": "BTN_LEFT", "RIGHT": "BTN_RIGHT", "MIDDLE": "BTN_MIDDLE",
                 "SIDE": "BTN_SIDE", "EXTRA": "BTN_EXTRA"}


def parse_action(text, ecodes):
    text = (text or "none").strip()
    if text == "none":
        return Action("none")
    if text in ("osk", "screen", "end-stream"):
        return Action(text)
    if text.startswith("cmd:"):
        return Action("cmd", command=text[4:].strip())
    if text.startswith("mouse:"):
        name = MOUSE_BUTTONS.get(text[6:].strip().upper())
        if not name:
            raise ValueError(f"unknown mouse button in {text!r}")
        return Action("mouse", [getattr(ecodes, name)])
    if text.startswith("key:"):
        codes = []
        for part in text[4:].split("+"):
            name = "KEY_" + part.strip().upper()
            if not hasattr(ecodes, name):
                raise ValueError(f"unknown key {part!r} in {text!r}")
            codes.append(getattr(ecodes, name))
        return Action("key", codes)
    raise ValueError(f"unknown action {text!r}")


# ----------------------------------------------------------------------------- pad -> desktop

def stick_magnitude(x, y, deadzone, curve):
    """Return (unit_x, unit_y, strength 0..1) for a stick position."""
    m = math.hypot(x, y)
    if m <= deadzone:
        return 0.0, 0.0, 0.0
    n = min(1.0, (m - deadzone) / (1.0 - deadzone))
    return x / m, y / m, n ** curve


class Mapper:
    """Turns pad state into desktop input. `out` must provide:
    key(code, down), rel(code, value), syn(), osk_toggle(), run(cmd), notify(text)."""

    def __init__(self, cfg, ecodes, out):
        self.cfg, self.e, self.out = cfg, ecodes, out
        self.buttons = {name: parse_action(cfg["buttons"].get(name, "none"), ecodes) for name in CONTROLS}
        self.combos = {}
        for combo, action in cfg["combos"].items():
            mod, _, btn = combo.partition("+")
            if mod in CONTROLS and btn in CONTROLS:
                self.combos[(mod, btn)] = parse_action(action, ecodes)
        self.modifiers = {mod for mod, _ in self.combos}
        self.reset()

    def reset(self):
        self.held = {}             # control -> Action currently held down
        self.down = set()          # controls physically down
        self.mod_used = set()      # modifiers that took part in a combo while held
        self.pressed_keys = {}     # code -> count (so overlapping actions do not release early)
        self.lx = self.ly = self.rx = self.ry = 0.0
        self.mouse_acc = [0.0, 0.0]
        self.scroll_acc = [0.0, 0.0]
        self.hires_acc = [0.0, 0.0]
        self.full_tilt_for = 0.0
        self.pause_since = None

    # --- low level output, with reference counting for keys
    def _press(self, action):
        if action.kind in ("key", "mouse"):
            for code in action.codes:
                n = self.pressed_keys.get(code, 0)
                self.pressed_keys[code] = n + 1
                if n == 0:
                    self.out.key(code, True)
            self.out.syn()
        elif action.kind == "osk":
            self.out.osk_toggle()
        elif action.kind == "screen":
            self.out.screen_toggle()
        elif action.kind == "end-stream":
            self.out.end_stream()
        elif action.kind == "cmd" and action.command:
            self.out.run(action.command)

    def _release(self, action):
        if action.kind in ("key", "mouse"):
            for code in reversed(action.codes):
                n = self.pressed_keys.get(code, 0)
                if n <= 1:
                    self.pressed_keys.pop(code, None)
                    if n == 1:
                        self.out.key(code, False)
                else:
                    self.pressed_keys[code] = n - 1
            self.out.syn()

    def release_all(self):
        for action in list(self.held.values()):
            self._release(action)
        for code in list(self.pressed_keys):
            self.out.key(code, False)
        if self.pressed_keys:
            self.out.syn()
        self.reset()

    # --- controls
    def control(self, name, pressed):
        if pressed:
            if name in self.down:
                return
            self.down.add(name)
            if name == self.cfg.get("pause_hold"):
                self.pause_since = time.monotonic()
            combo = next((self.combos[(m, name)] for m in self.down if (m, name) in self.combos and m != name), None)
            if combo is not None:
                for m in self.down:
                    if (m, name) in self.combos:
                        self.mod_used.add(m)
                self.held[name] = combo
                self._press(combo)
            elif name in self.modifiers:
                pass  # its own action fires on release if no combo was used
            else:
                action = self.buttons[name]
                self.held[name] = action
                self._press(action)
        else:
            if name not in self.down:
                return
            self.down.discard(name)
            if name == self.cfg.get("pause_hold"):
                self.pause_since = None
            if name in self.held:
                self._release(self.held.pop(name))
            elif name in self.modifiers and name not in self.mod_used:
                action = self.buttons[name]  # tap of a modifier: press and release its own action
                self._press(action)
                self._release(action)
            self.mod_used.discard(name)

    def pause_requested(self, now):
        """True once the pause control has been held for a second (then resets)."""
        if self.pause_since is not None and now - self.pause_since >= 1.0:
            self.pause_since = None
            return True
        return False

    # --- sticks, called every frame
    def tick(self, dt):
        cfg, e = self.cfg, self.e
        moved = False
        # mouse
        ux, uy, s = stick_magnitude(self.lx, self.ly, cfg["deadzone"], cfg["mouse_curve"])
        if s > 0:
            self.full_tilt_for = self.full_tilt_for + dt if s > 0.9 else 0.0
            boost = 1.0 + (cfg["mouse_boost"] - 1.0) * min(1.0, max(0.0, (self.full_tilt_for - 0.35) / 0.6))
            speed = cfg["mouse_speed"] * s * boost
            for i, u in enumerate((ux, uy)):
                self.mouse_acc[i] += u * speed * dt
            dx, dy = int(self.mouse_acc[0]), int(self.mouse_acc[1])
            self.mouse_acc[0] -= dx
            self.mouse_acc[1] -= dy
            if dx:
                self.out.rel(e.REL_X, dx)
                moved = True
            if dy:
                self.out.rel(e.REL_Y, dy)
                moved = True
        else:
            self.full_tilt_for = 0.0
            self.mouse_acc = [0.0, 0.0]
        # scroll: stick up = scroll up (positive wheel), stick right = scroll right
        ux, uy, s = stick_magnitude(self.rx, self.ry, cfg["deadzone"], cfg["scroll_curve"])
        if s > 0:
            notches = cfg["scroll_speed"] * s * dt
            for i, (u, sign) in enumerate(((ux, 1), (uy, -1))):
                units = u * sign * notches * 120
                self.hires_acc[i] += units
                self.scroll_acc[i] += units
            hx, hy = int(self.hires_acc[0]), int(self.hires_acc[1])
            self.hires_acc[0] -= hx
            self.hires_acc[1] -= hy
            if hy:
                self.out.rel(e.REL_WHEEL_HI_RES, hy)
                moved = True
            if hx:
                self.out.rel(e.REL_HWHEEL_HI_RES, hx)
                moved = True
            for i, code in ((1, e.REL_WHEEL), (0, e.REL_HWHEEL)):
                while abs(self.scroll_acc[i]) >= 120:
                    step = 1 if self.scroll_acc[i] > 0 else -1
                    self.scroll_acc[i] -= 120 * step
                    self.out.rel(code, step)
                    moved = True
        else:
            self.scroll_acc = [0.0, 0.0]
            self.hires_acc = [0.0, 0.0]
        if moved:
            self.out.syn()
        return moved


# ----------------------------------------------------------------------------- reading pads

@functools.lru_cache(maxsize=4)
def button_names(e, swap_xy):
    return {
        e.BTN_SOUTH: "A", e.BTN_EAST: "B",
        e.BTN_X: "Y" if swap_xy else "X", e.BTN_Y: "X" if swap_xy else "Y",
        e.BTN_TL: "LB", e.BTN_TR: "RB", e.BTN_TL2: "LT", e.BTN_TR2: "RT",
        e.BTN_THUMBL: "L3", e.BTN_THUMBR: "R3",
        e.BTN_SELECT: "View", e.BTN_START: "Start", e.BTN_MODE: "Xbox",
        e.BTN_DPAD_UP: "Up", e.BTN_DPAD_DOWN: "Down", e.BTN_DPAD_LEFT: "Left", e.BTN_DPAD_RIGHT: "Right",
    }


def pad_event_to_controls(event_type, code, value, e, swap_xy):
    """Map one evdev event to [(control, pressed)] and/or axis updates [(axis, value)].
    Axis values here are raw; the caller normalises them."""
    if event_type == e.EV_KEY:
        name = button_names(e, swap_xy).get(code)
        if name and value in (0, 1):
            return [(name, value == 1)], []
        return [], []
    if event_type == e.EV_ABS:
        return [], [(code, value)]
    return [], []


class PadState:
    """Normalises one pad's axes and turns triggers / hat into button presses."""

    def __init__(self, absinfo, e):
        self.e = e
        self.info = absinfo  # code -> (min, max)
        self.trigger_down = {"LT": False, "RT": False}
        self.hat = {"x": 0, "y": 0}

    def norm_stick(self, code, value):
        lo, hi = self.info.get(code, (-32768, 32767))
        if hi == lo:
            return 0.0
        return max(-1.0, min(1.0, (2.0 * (value - lo) / (hi - lo)) - 1.0))

    def norm_trigger(self, code, value):
        lo, hi = self.info.get(code, (0, 1023))
        return 0.0 if hi == lo else max(0.0, min(1.0, (value - lo) / (hi - lo)))

    def axis(self, code, value, mapper):
        e = self.e
        if code == e.ABS_X:
            mapper.lx = self.norm_stick(code, value)
        elif code == e.ABS_Y:
            mapper.ly = self.norm_stick(code, value)
        elif code == e.ABS_RX:
            mapper.rx = self.norm_stick(code, value)
        elif code == e.ABS_RY:
            mapper.ry = self.norm_stick(code, value)
        elif code in (e.ABS_Z, e.ABS_RZ, e.ABS_BRAKE, e.ABS_GAS):
            name = "LT" if code in (e.ABS_Z, e.ABS_BRAKE) else "RT"
            v = self.norm_trigger(code, value)
            down = self.trigger_down[name]
            if not down and v > 0.55:
                self.trigger_down[name] = True
                mapper.control(name, True)
            elif down and v < 0.35:
                self.trigger_down[name] = False
                mapper.control(name, False)
        elif code == e.ABS_HAT0X:
            self._hat("x", value, "Left", "Right", mapper)
        elif code == e.ABS_HAT0Y:
            self._hat("y", value, "Up", "Down", mapper)

    def _hat(self, axis, value, neg, pos, mapper):
        value = (value > 0) - (value < 0)
        old = self.hat[axis]
        if old == value:
            return
        if old:
            mapper.control(neg if old < 0 else pos, False)
        if value:
            mapper.control(neg if value < 0 else pos, True)
        self.hat[axis] = value


def is_gamepad(dev, e):
    caps = dev.capabilities(absinfo=False)
    keys = set(caps.get(e.EV_KEY, []))
    axes = set(caps.get(e.EV_ABS, []))
    return e.BTN_SOUTH in keys and e.ABS_X in axes and not dev.name.startswith(APP)


