class SunshineLog:
    """Follows sunshine.log to know whether a client is connected right now.

    Sunshine only runs the prep "undo" command when the app is quit in Moonlight; turning
    the TV off or leaving Moonlight just pauses the stream. The log tells the two apart.
    state: True (client connected), False (disconnected / paused), None (nothing logged yet).
    """

    CONNECTED = re.compile(rb"client\s+connected", re.I)
    DISCONNECTED = re.compile(rb"client\s+disconnected", re.I)

    def __init__(self, path):
        self.path = path
        self.inode = None
        self.offset = 0
        self.rest = b""
        self.state = None

    def poll(self):
        try:
            st = os.stat(self.path)
        except OSError:
            return self.state
        if st.st_ino != self.inode or st.st_size < self.offset:
            # new or truncated log (Sunshine restarted): start over
            self.inode, self.offset, self.rest, self.state = st.st_ino, 0, b"", None
        if st.st_size == self.offset:
            return self.state
        try:
            with open(self.path, "rb") as f:
                f.seek(self.offset)
                data = f.read(st.st_size - self.offset)
        except OSError:
            return self.state
        self.offset += len(data)
        lines = (self.rest + data).split(b"\n")
        self.rest = lines.pop()
        for line in lines:
            if self.DISCONNECTED.search(line):
                self.state = False
            elif self.CONNECTED.search(line):
                self.state = True
        return self.state


def sunshine_running():
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
                if f.read().strip() == "sunshine":
                    return True
        except OSError:
            continue
    return False


def focused_window_class():
    if not shutil.which("hyprctl") or not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return ""
    try:
        out = subprocess.run(["hyprctl", "-j", "activewindow"], capture_output=True, text=True, timeout=1)
        data = json.loads(out.stdout or "{}")
        return str(data.get("class") or data.get("initialClass") or "")
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""


def notify(text, enabled=True):
    log(text)
    if enabled and shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "tv-pad", "-t", "2500", "Pad", text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ----------------------------------------------------------------------------- monitor & stream

def run_quiet(cmd, timeout=10):
    """Run a command (list); True if it worked."""
    if not cmd or not shutil.which(cmd[0]):
        log(f"not found: {cmd[0] if cmd else '(empty command)'}")
        return False
    try:
        r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as err:
        log(f"{cmd[0]} failed: {err}")
        return False
    if r.returncode != 0:
        log(f"{' '.join(cmd)} failed: {r.stderr.strip()[:200]}")
    return r.returncode == 0


def query_quiet(cmd, timeout=10):
    """Run a command and return its output, or None."""
    if not cmd or not shutil.which(cmd[0]):
        return None
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def parse_brightness(text):
    """`ddcutil --brief getvcp 10` prints e.g. "VCP 10 C 70 100"; returns 70."""
    m = re.search(r"VCP\s+10\s+C\s+(\d+)\s+\d+", text or "")
    return int(m.group(1)) if m else None


BRIGHTNESS_FILE = os.path.join(STATE_DIR, "brightness")


def sunshine_close_app(cfg):
    """Ask Sunshine to close the running app (ends the stream and runs the prep undo)."""
    if not cfg["sunshine_user"]:
        return False
    url = cfg["sunshine_url"].rstrip("/") + "/api/apps/close"
    token = base64.b64encode(f"{cfg['sunshine_user']}:{cfg['sunshine_password']}".encode()).decode()
    req = urllib.request.Request(url, data=b"{}", method="POST",
                                 headers={"Authorization": f"Basic {token}", "Content-Type": "application/json"})
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE  # Sunshine uses a self-signed certificate on localhost
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=5) as resp:
            return 200 <= resp.status < 300
    except OSError as err:
        log(f"Sunshine API close failed: {err}")
        return False


class Session:
    """PC monitor dark / back and ending the stream. The callables are swappable for tests."""

    def __init__(self, cfg, run=run_quiet, close_app=sunshine_close_app, background=True, query=query_quiet):
        self.cfg = cfg
        self.run = run
        self.query = query
        self.close_app = close_app
        self.background = background
        self.screen_off = False
        self.jobs = queue.Queue()
        self.worker = None
        # A previous run may have left the monitor dimmed (crash, power loss of the session).
        saved = self._read_saved()
        if saved is not None:
            self._go(lambda: self._restore(saved))

    def _go(self, fn):
        """Run monitor / Sunshine jobs one after another, off the input loop."""
        if not self.background:
            fn()
            return
        self.jobs.put(fn)
        if self.worker is None or not self.worker.is_alive():
            self.worker = threading.Thread(target=self._work, daemon=True)
            self.worker.start()

    def _work(self):
        while True:
            try:
                fn = self.jobs.get(timeout=1)
            except queue.Empty:
                return
            try:
                fn()
            except Exception as err:  # never let a failed command kill the worker
                log(f"job failed: {err}")

    def _read_saved(self):
        try:
            with open(BRIGHTNESS_FILE, encoding="utf-8") as f:
                return int(f.read().strip())
        except (OSError, ValueError):
            return None

    def _dim(self):
        level = parse_brightness(self.query(["ddcutil", "--brief", "getvcp", "10"]))
        if level:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(BRIGHTNESS_FILE, "w", encoding="utf-8") as f:
                f.write(str(level))
        self.run(["ddcutil", "--noverify", "setvcp", "10", "0"])

    def _restore(self, level=None):
        level = level or self._read_saved() or 70
        self.run(["ddcutil", "--noverify", "setvcp", "10", str(level)])
        try:
            os.remove(BRIGHTNESS_FILE)
        except FileNotFoundError:
            pass

    def screen_toggle(self, notify_fn=notify):
        if self.screen_off:
            self.screen_on()
            notify_fn("Monitor włączony")
        else:
            self.screen_off = True
            if self.cfg["screen_mode"] == "commands":
                self._go(lambda: self.run(self.cfg["screen_off_command"]))
            else:
                self._go(self._dim)
            notify_fn("Monitor wygaszony (View + ↑ włącza)")

    def screen_on(self):
        if self.screen_off:
            self.screen_off = False
            if self.cfg["screen_mode"] == "commands":
                self._go(lambda: self.run(self.cfg["screen_on_command"]))
            else:
                self._go(self._restore)

    def end_stream(self, notify_fn=notify):
        self.screen_on()
        try:
            os.remove(ACTIVE_FLAG)  # pad control stops right away
        except FileNotFoundError:
            pass
        notify_fn("Kończę stream")

        def close():
            if not self.close_app(self.cfg):
                self.run(["systemctl", "--user", "restart", self.cfg["sunshine_service"]])

        self._go(close)


