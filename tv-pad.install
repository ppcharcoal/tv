post_install() {
  cat <<'EOF'
==> tv-pad: finish the setup as your normal user (not root):
      systemctl --user enable --now tv-pad
      tv-pad setup-sunshine
      systemctl --user restart app-dev.lizardbyte.app.Sunshine.service
EOF
}

post_upgrade() {
  cat <<'EOF'
==> tv-pad: restart it to use the new version:
      systemctl --user restart tv-pad
EOF
}
